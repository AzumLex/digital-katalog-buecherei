# Build-Ergebnisse
dist/
# Der Serverteil des Builds. Liegt neben dist/ und nicht darin, damit der Adapter
# ihn nicht in das öffentlich ausgelieferte Verzeichnis kopiert (astro.config.mjs).
dist-server/
.astro/
.output/
.vercel/

# Abhängigkeiten
node_modules/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Umgebungsvariablen
# Muster mit Stern: Die Datei für die lokale Arbeit heißt .env.local, ohne
# zweiten Punkt — .env.*.local hat sie nicht erfasst.
.env
.env.production
.env*.local

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Betriebssystem / Editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
