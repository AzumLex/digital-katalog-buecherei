---
/**
 * Suchleiste der Startseite.
 *
 * Das Feld steht schon an seinem Platz, sucht aber noch nicht — die Suche ist eine
 * eigene Ausbaustufe. Bewusst als `disabled` ausgezeichnet statt als Feld, das
 * Eingaben annimmt und dann nichts tut: Ein Formular, das so aussieht als ob, ist
 * ärgerlicher als eines, das ehrlich sagt, dass es noch nicht so weit ist.
 */
---

<section class="suche" aria-labelledby="suche-titel">
  <h2 id="suche-titel" class="nur-vorlesen">Suche</h2>
  <label class="label" for="suchfeld">Im Bestand suchen</label>
  <input
    id="suchfeld"
    class="feld"
    type="search"
    placeholder="Titel, Autor, Reihe …"
    disabled
    aria-describedby="suche-hinweis"
  />
  <p id="suche-hinweis" class="hinweis">
    Die Suche wird gerade gebaut. Bis dahin geht es über die Sparten.
  </p>
</section>

<style>
  .suche {
    margin-bottom: var(--abstand-5);
  }

  .label {
    display: block;
    margin-bottom: var(--abstand-2);
    font-family: var(--schrift-ui);
    font-size: var(--text-klein);
    font-weight: 600;
    color: var(--farbe-text-leise);
  }

  .feld {
    width: 100%;
    padding: 0.75rem var(--abstand-3);
    background: var(--farbe-flaeche-leise);
    border: 1px solid var(--farbe-rand);
    border-radius: var(--radius);
    color: var(--farbe-text-leise);
    font-family: var(--schrift-ui);
    font-size: var(--text-normal);
    /* 16px verhindert, dass iOS beim Antippen hineinzoomt. */
  }

  .feld:disabled {
    cursor: not-allowed;
  }

  .hinweis {
    margin: var(--abstand-2) 0 0;
    font-family: var(--schrift-ui);
    font-size: var(--text-klein);
    color: var(--farbe-text-leise);
  }
</style>
