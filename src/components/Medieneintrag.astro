---
/**
 * Eine Zeile der Listenansicht.
 *
 * Was in der Zeile steht, entscheidet `src/lib/zeile.ts` — dieselbe Funktion nutzt
 * das Filterskript, wenn es die Liste im Browser neu aufbaut. Hier wird das Ergebnis
 * nur noch in Markup gegossen. Die Klassennamen sind global (siehe
 * `.katalogliste` in `global.css`), damit die im Browser erzeugten Zeilen genauso
 * aussehen wie die aus dem Build.
 */
import { zeilenfelder, type Zeilenquelle } from '../lib/zeile';
import { titelPfad } from '../lib/pfade';

interface Props {
  medium: Zeilenquelle;
  /** Ankername für den Block eines Autors; nur beim ersten Titel des Autors gesetzt. */
  anker?: string;
}

const { medium, anker } = Astro.props;
const felder = zeilenfelder(medium);
---

<li class="eintrag" id={anker}>
  {felder.autor && <p class="autor">{felder.autor}</p>}

  <h3 class="titel">
    <a href={titelPfad(medium.id)}>{felder.titel}</a>
  </h3>

  {felder.untertitel && <p class="untertitel">{felder.untertitel}</p>}
  {felder.reihe && <p class="reihe">{felder.reihe}</p>}

  {
    /* Bei Tonies erkennen Kinder das Medium an der Figur, nicht am Titel —
       deshalb steht sie hier direkt beim Titel und nicht unten bei den Details. */
    felder.figur && (
      <p class="figur">
        <span class="figur-label">Figur</span>
        {felder.figur}
      </p>
    )
  }

  {felder.zusatz && <p class="zusatz">{felder.zusatz}</p>}
</li>
