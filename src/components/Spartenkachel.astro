---
/**
 * Eine Sparte als Kachel auf der Startseite.
 *
 * Leere Sparten bleiben sichtbar und anklickbar, damit erkennbar ist, was die
 * Bücherei noch zu erfassen hat. Sie sind nur zurückhaltender gesetzt.
 */
import type { Sparte } from '../lib/daten';
import { spartenPfad } from '../lib/pfade';

interface Props {
  sparte: Sparte;
  bezeichnung: string;
  anzahl: number;
}

const { sparte, bezeichnung, anzahl } = Astro.props;
const leer = anzahl === 0;
---

<a class:list={['kachel', { leer }]} href={spartenPfad(sparte)}>
  <span class="name">{bezeichnung}</span>
  <span class="anzahl">
    {leer ? 'noch keine Einträge' : `${anzahl.toLocaleString('de-AT')} Titel`}
  </span>
</a>

<style>
  .kachel {
    display: flex;
    flex-direction: column;
    gap: var(--abstand-1);
    padding: var(--abstand-3);
    min-height: 5rem;
    justify-content: center;
    background: var(--farbe-flaeche);
    border: 1px solid var(--farbe-rand);
    border-radius: var(--radius);
    color: inherit;
    text-decoration: none;
    transition:
      border-color var(--uebergang),
      background-color var(--uebergang);
  }

  .kachel:hover {
    border-color: var(--farbe-akzent);
    background: var(--farbe-akzent-leise);
    color: inherit;
  }

  .name {
    font-size: var(--text-gross);
    line-height: var(--zeilenhoehe-eng);
  }

  .anzahl {
    font-family: var(--schrift-ui);
    font-size: var(--text-klein);
    color: var(--farbe-text-leise);
  }

  .kachel.leer {
    background: transparent;
    border-style: dashed;
  }

  .kachel.leer .name {
    color: var(--farbe-text-leise);
  }
</style>
