---
/**
 * Startseite: Suchleiste, Sparten als Kacheln, darunter die Neuzugänge.
 */
import Grundgeruest from '../layouts/Grundgeruest.astro';
import Medieneintrag from '../components/Medieneintrag.astro';
import Spartenkachel from '../components/Spartenkachel.astro';
import Suchleiste from '../components/Suchleiste.astro';
import { alleMedien, spartenUebersicht } from '../lib/daten';
import { sortiere } from '../lib/sortierung';

/**
 * „Neu im Bestand" hängt allein an `erfasst_am` — dem Datum, an dem ein Medium in
 * die Bücherei aufgenommen wurde. Das Erscheinungsjahr taugt dafür nicht: Ein 2019
 * erschienener Roman kann vorige Woche gekauft worden sein und umgekehrt.
 *
 * Derzeit ist das Feld bei keinem Eintrag gepflegt, deshalb steht hier vorerst ein
 * Hinweis. Sobald bei Neuzugängen ein Datum gesetzt wird, füllt sich der Abschnitt
 * von allein.
 */
const mitAufnahmedatum = alleMedien.filter((medium) => Boolean(medium.erfasst_am));
const neuzugaenge = sortiere(mitAufnahmedatum, 'neu').slice(0, 12);
---

<Grundgeruest
  titel="Büchereikatalog"
  beschreibung="Digitaler Index der Büchereimedien — Romane, Tonies und mehr, nach Sparten geordnet."
  istStartseite
>
  <h1 class="ueberschrift">Büchereikatalog</h1>
  <p class="einleitung">
    Der gesamte Bestand der Bücherei zum Nachschlagen — auch direkt am Regal.
  </p>

  <Suchleiste />

  <section aria-labelledby="sparten-titel">
    <h2 id="sparten-titel" class="abschnitt">Sparten</h2>
    <div class="kacheln">
      {
        spartenUebersicht.map((eintrag) => (
          <Spartenkachel
            sparte={eintrag.sparte}
            bezeichnung={eintrag.bezeichnung}
            anzahl={eintrag.anzahl}
          />
        ))
      }
    </div>
  </section>

  <section class="neu" aria-labelledby="neu-titel">
    <h2 id="neu-titel" class="abschnitt">Neu im Bestand</h2>

    {
      neuzugaenge.length > 0 ? (
        <ul class="liste">
          {neuzugaenge.map((medium) => (
            <Medieneintrag medium={medium} />
          ))}
        </ul>
      ) : (
        <div class="leerhinweis">
          <p>Noch keine Aufnahmedaten erfasst.</p>
          <p class="klein">
            Sobald bei Neuzugängen das Feld <code>erfasst_am</code> gesetzt wird, erscheinen hier
            automatisch die zwölf zuletzt aufgenommenen Titel.
          </p>
        </div>
      )
    }
  </section>
</Grundgeruest>

<style>
  .ueberschrift {
    margin: 0;
    font-size: var(--text-titel);
    letter-spacing: -0.01em;
  }

  .einleitung {
    margin: var(--abstand-2) 0 var(--abstand-5);
    color: var(--farbe-text-leise);
  }

  .abschnitt {
    margin: 0 0 var(--abstand-3);
    padding-bottom: var(--abstand-2);
    border-bottom: 1px solid var(--farbe-rand);
    font-family: var(--schrift-ui);
    font-size: var(--text-klein);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--farbe-text-leise);
  }

  .kacheln {
    display: grid;
    gap: var(--abstand-2);
    grid-template-columns: 1fr;
  }

  @media (min-width: 30rem) {
    .kacheln {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 44rem) {
    .kacheln {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .neu {
    margin-top: var(--abstand-5);
  }

  .liste {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--farbe-rand);
  }

  .leerhinweis {
    padding: var(--abstand-4);
    background: var(--farbe-flaeche-leise);
    border: 1px dashed var(--farbe-rand-kraeftig);
    border-radius: var(--radius);
  }

  .leerhinweis p {
    margin: 0;
  }

  .leerhinweis .klein {
    margin-top: var(--abstand-2);
    font-family: var(--schrift-ui);
    font-size: var(--text-klein);
    color: var(--farbe-text-leise);
  }

  code {
    font-family: var(--schrift-zahl);
    font-size: 0.9em;
  }
</style>
