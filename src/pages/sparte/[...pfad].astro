---
/**
 * Listenansicht einer Sparte.
 *
 * Alle Kombinationen aus Sparte, Sortierung und Seite werden beim Build als eigene
 * Seiten erzeugt. Dadurch braucht die Liste kein JavaScript: Umsortieren und Blättern
 * sind normale Links auf fertiges HTML.
 */
import type { GetStaticPaths } from 'astro';
import Grundgeruest from '../../layouts/Grundgeruest.astro';
import Blaetterung from '../../components/Blaetterung.astro';
import Filterpanel from '../../components/Filterpanel.astro';
import Medieneintrag from '../../components/Medieneintrag.astro';
import Sortierwahl from '../../components/Sortierwahl.astro';
import { facettenDerSparte } from '../../lib/listendaten';
import { SPARTEN, alleMedien, medienDerSparte, spartenNachName, type Medium, type Sparte } from '../../lib/daten';
import { ankerIds } from '../../lib/autoren';
import { autorAnker, spartenPfad, spartenSegmente } from '../../lib/pfade';
import {
  SORTIERUNGEN,
  SORTIER_TEXTE,
  STANDARD_SORTIERUNG,
  anzahlSeiten,
  seiteVon,
  sortiere,
  type Seite,
  type Sortierung,
} from '../../lib/sortierung';

/** Ohne ein einziges Aufnahmedatum im Bestand hat „Zuletzt aufgenommen" nichts zu ordnen. */
const neuVerfuegbar = alleMedien.some((medium) => Boolean(medium.erfasst_am));

export const getStaticPaths = (() => {
  const hatAufnahmedatum = alleMedien.some((medium) => Boolean(medium.erfasst_am));

  return SPARTEN.flatMap((sparte) => {
    const medien = medienDerSparte(sparte);
    const anker = ankerIds(sparte);

    // Die Sortierung „zuletzt aufgenommen" wird erst gebaut, wenn es Aufnahmedaten
    // gibt — sonst entstünden Seiten, die nur eine zufällige Reihenfolge zeigen.
    const sortierungen = SORTIERUNGEN.filter((s) => s !== 'neu' || hatAufnahmedatum);

    return sortierungen.flatMap((sortierung) => {
      const sortiert = sortiere(medien, sortierung);
      const seiten = anzahlSeiten(sortiert.length);

      return Array.from({ length: seiten }, (_, i) => {
        const nummer = i + 1;
        return {
          params: { pfad: spartenSegmente(sparte, sortierung, nummer).join('/') },
          props: {
            sparte,
            sortierung,
            seite: seiteVon(sortiert, nummer),
            // Anker nur in der Standardsortierung: Nur dort stehen die Titel eines
            // Autors als zusammenhängender Block.
            anker: sortierung === STANDARD_SORTIERUNG ? anker : new Map<string, string>(),
          },
        };
      });
    });
  });
}) satisfies GetStaticPaths;

interface Props {
  sparte: Sparte;
  sortierung: Sortierung;
  seite: Seite<Medium>;
  anker: ReadonlyMap<string, string>;
}

const { sparte, sortierung, seite, anker } = Astro.props;

const datei = spartenNachName.get(sparte);
const bezeichnung = datei?.bezeichnung ?? sparte;

// Welche Filter diese Sparte hat, steht schon beim Build fest — abgeleitet aus den
// Daten, nicht je Sparte festgelegt. Die Werte samt Trefferzahlen füllt das Skript.
const facetten = facettenDerSparte(sparte);

const seitenTitel =
  seite.anzahlSeiten > 1
    ? `${bezeichnung} — Seite ${seite.nummer} von ${seite.anzahlSeiten}`
    : bezeichnung;

/**
 * Dieselbe Liste liegt in vier Sortierungen vor. Für Suchmaschinen ist das viermal
 * derselbe Inhalt, deshalb wird nur die Standardsortierung indexiert; die übrigen
 * verweisen darauf und bleiben „follow", damit die Titelseiten trotzdem gefunden
 * werden.
 */
const istStandard = sortierung === STANDARD_SORTIERUNG;
const kanonisch = istStandard
  ? spartenPfad(sparte, sortierung, seite.nummer)
  : spartenPfad(sparte, STANDARD_SORTIERUNG);

const filterNamen = facetten.filter((f) => f.art !== 'schalter').map((f) => f.titel);
const beschreibung =
  seite.anzahlEintraege === 0
    ? `${bezeichnung}: Diese Sparte der Bücherei ist noch nicht erfasst.`
    : `${seite.anzahlEintraege.toLocaleString('de-AT')} Titel der Sparte ${bezeichnung} im Bestand der Bücherei` +
      (filterNamen.length > 0 ? ` — filtern nach ${filterNamen.join(', ')}.` : '.');
---

<Grundgeruest
  titel={`${seitenTitel} · Büchereikatalog`}
  beschreibung={beschreibung}
  kanonisch={kanonisch}
  nichtIndexieren={!istStandard}
>
  <nav class="brotkrumen" aria-label="Pfad">
    <a href="/">Katalog</a> <span aria-hidden="true">›</span> <span>{bezeichnung}</span>
  </nav>

  <h1 class="ueberschrift">{bezeichnung}</h1>

  {
    seite.anzahlEintraege > 0 ? (
      <p class="bilanz" id="bilanz">
        {seite.anzahlEintraege.toLocaleString('de-AT')} Titel
        {seite.anzahlSeiten > 1 && (
          <>
            {' · '}
            angezeigt {seite.von}–{seite.bis}
          </>
        )}
      </p>
    ) : (
      <p class="bilanz">Diese Sparte ist noch nicht erfasst.</p>
    )
  }

  {
    seite.anzahlEintraege > 0 && (
      <div
        id="katalogansicht"
        data-sparte={sparte}
        data-sortierung={sortierung}
        data-seite={seite.nummer}
      >
        <div class="werkzeuge">
          <Sortierwahl sparte={sparte} aktuell={sortierung} neuVerfuegbar={neuVerfuegbar} />
        </div>

        <Filterpanel sparte={sparte} facetten={facetten} />

        <div class="filter-aktiv" id="filter-aktiv" hidden />

        <p class="nur-vorlesen">Sortierung: {SORTIER_TEXTE[sortierung].lang}</p>

        <ul class="katalogliste" id="katalogliste">
          {seite.eintraege.map((medium) => {
            const schluessel = anker.get(medium.id);
            return <Medieneintrag medium={medium} anker={schluessel ? autorAnker(schluessel) : undefined} />;
          })}
        </ul>

        <div id="blaetterung">
          <Blaetterung sparte={sparte} sortierung={sortierung} seite={seite} />
        </div>
      </div>
    )
  }

  <script>
    import { starteFilter } from '../../scripts/filter';
    starteFilter();
  </script>

  {
    seite.anzahlEintraege === 0 && (
      <div class="leerhinweis">
        <p>
          Für diese Sparte liegen noch keine Daten vor. Die Sparte ist bereits angelegt, damit die
          Titel nur noch eingetragen werden müssen.
        </p>
        <p class="klein">
          Wie das geht, steht in der <code>README.md</code> unter „Einen Titel hinzufügen“.
        </p>
      </div>
    )
  }
</Grundgeruest>

<style>
  .brotkrumen {
    font-family: var(--schrift-ui);
    font-size: var(--text-klein);
    color: var(--farbe-text-leise);
  }

  .brotkrumen span {
    margin: 0 0.25em;
  }

  .ueberschrift {
    margin: var(--abstand-2) 0 0;
    font-size: var(--text-titel);
    letter-spacing: -0.01em;
  }

  .bilanz {
    margin: var(--abstand-2) 0 0;
    font-family: var(--schrift-ui);
    font-size: var(--text-klein);
    color: var(--farbe-text-leise);
  }

  .werkzeuge {
    margin: var(--abstand-4) 0 var(--abstand-3);
    padding-bottom: var(--abstand-3);
    border-bottom: 1px solid var(--farbe-rand);
  }


  .leerhinweis {
    margin-top: var(--abstand-4);
    padding: var(--abstand-4);
    background: var(--farbe-flaeche-leise);
    border: 1px dashed var(--farbe-rand-kraeftig);
    border-radius: var(--radius);
  }

  .leerhinweis p {
    margin: 0;
  }

  .leerhinweis .klein {
    margin-top: var(--abstand-2);
    font-family: var(--schrift-ui);
    font-size: var(--text-klein);
    color: var(--farbe-text-leise);
  }

  code {
    font-family: var(--schrift-zahl);
    font-size: 0.9em;
  }
</style>
